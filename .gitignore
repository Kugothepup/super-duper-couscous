# Secrets and personal data
.secrets/
studies/*/raw/
studies/*/sealed/
studies/*/human/
# old codebook versions' files, which may include a human/ folder
studies/*/superseded/
# earlier rounds and reset archives hold human/ folders and builds too (D35, D40)
studies/*/rounds/
studies/*/archive/

# Internal builds quote posts (crp build --with-quotes): never commit them
studies/*/results/internal/
# Default builds are quote-free, but stay out of git unless committed deliberately
studies/*/results/dashboard.html
studies/*/results/report.md

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
